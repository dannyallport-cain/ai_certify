# Base Railway connection (update with your credentials)
# Use Railway's Postgres URL for both runtime and tooling.
POSTGRES_URL=postgresql://postgres:password@your-railway-host.railway.internal:5432/railway
DATABASE_URL=postgresql://postgres:password@your-railway-host.railway.internal:5432/railway
POSTGRES_HOST=your-railway-host.railway.internal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-railway-password
POSTGRES_DATABASE=railway

# Web app URLs / auth secrets
# Web app is hosted on Vercel. Keep BASE_URL and NEXT_PUBLIC_APP_URL aligned to the web app origin.
BASE_URL=https://your-web-app.vercel.app
NEXT_PUBLIC_APP_URL=https://your-web-app.vercel.app
NEXTAUTH_URL=https://your-web-app.vercel.app
AUTH_SECRET=replace-with-auth-secret
NEXTAUTH_SECRET=replace-with-nextauth-secret

# Stripe configuration (replace with your keys)
STRIPE_SECRET_KEY=sk_test_replace_with_your_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_secret
STRIPE_VERIFICATION_PRICE_ID=price_replace_with_your_verification_price

# Transactional email / verification emails
RESEND_API_KEY=re_replace_with_your_resend_key
EMAIL_FROM=AI Certificates <no-reply@your-domain.example>

# Vercel AI Gateway / AI providers
AI_GATEWAY_API_KEY=vck_replace_with_your_key
AI_GATEWAY_MODEL=anthropic/claude-sonnet-4.6
AI_GATEWAY_SEARCH_MODEL=openai/gpt-5.4
OPENAI_API_KEY=sk-replace-with-openai-key

# Google API keys (optional)
GOOGLE_MAPS_API_KEY=AIzaSyReplaceWithYourKey
NEXT_PUBLIC_GOOGLE_STREET_VIEW_API_KEY=AIzaSyReplaceWithYourKey

# Stack environment variables (replace all values)
NEXT_PUBLIC_STACK_PROJECT_ID=replace-with-stack-project-id
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=replace-with-stack-publishable-client-key
STACK_SECRET_SERVER_KEY=replace-with-stack-secret-server-key

# Cloudflare R2 object storage
R2_ACCOUNT_ID=ae50656dca5528d3f28ac637b646886e
R2_BUCKET=aicertify
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# Optional: custom public base URL for object delivery, e.g. https://cdn.ai-certificates.app
R2_PUBLIC_BASE_URL=

# Database backup trigger + worker integration
# Vercel Cron calls /api/cron/db-backup, which forwards to the Railway worker.
RAILWAY_BACKUP_WORKER_URL=https://your-railway-worker.up.railway.app
BACKUP_SHARED_SECRET=replace-with-a-long-random-shared-secret
# Optional but recommended for Vercel Cron auth: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-a-long-random-cron-secret

# Backup automation
# Vercel forwards the cron trigger to the Railway worker root URL (no trailing slash).
RAILWAY_BACKUP_WORKER_URL=https://your-railway-worker.up.railway.app
# Shared secret used between Vercel and Railway worker via X-Backup-Token.
BACKUP_SHARED_SECRET=replace-with-shared-backup-secret
# Optional but recommended: Vercel Cron Authorization header secret.
CRON_SECRET=replace-with-vercel-cron-secret