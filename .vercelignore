# CLI deployments upload the working directory, so everything that is not part
# of the Next.js app or its build has to be excluded explicitly. Without this
# file the upload is ~1.4GB (mostly node_modules and the 3.9GB mobile project).
#
# Every entry is anchored with a leading `/` so it only matches the repository
# root. An unanchored `mobile` here also matches `app/api/mobile/...` and strips
# the entire mobile API out of the deployment.
/node_modules
/.git
/.github

# Native mobile app — built and shipped with Xcode/EAS, never part of the web app.
#
# /mobile/modules is the exception: the web zone-plan viewer imports the plan
# geometry from it, so the runtime-heavy directories are excluded individually
# instead of the whole tree. Excluding the whole tree breaks the web build with
# "Module not found: @/mobile/modules/fire-alarm-roomplan/...".
/mobile/app
/mobile/components
/mobile/services
/mobile/scripts
/mobile/assets
/mobile/ios
/mobile/android
/mobile/build
/mobile/node_modules
/mobile/plugins
/mobile/lib
/mobile/.expo
/mobile/dist
/mobile/package-lock.json

# Python ML pipeline and the Railway workers run as separate services.
/ml
/railway-ai-worker

