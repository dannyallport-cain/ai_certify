# ─── ServiceM8 Integration ──────────────────────────────────────────────────
# App credentials from ServiceM8 addon store
SERVICEM8_APP_ID=replace-with-servicem8-app-id
SERVICEM8_APP_SECRET=replace-with-servicem8-app-secret

# Web app public URL (ServiceM8 callbacks target the web app, not the Expo app)
# Set this to your deployed Vercel web app URL in production
NEXT_PUBLIC_APP_URL=https://your-web-app.vercel.app
BASE_URL=https://your-web-app.vercel.app
NEXTAUTH_URL=https://your-web-app.vercel.app

# Override these only if your callback URLs differ from the defaults
# SERVICEM8_CALLBACK_URL=https://your-web-app.vercel.app/api/servicem8/callback
# SERVICEM8_ACTIVATION_URL=https://your-web-app.vercel.app/api/servicem8/activate
