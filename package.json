{
  "name": "ai-certificates",
  "version": "1.0.0",
  "description": "Fire safety certificate management system",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "bin": {
    "build-and-install": "./mobile/build-and-install.sh"
  },
  "scripts": {
    "dev": "BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true BROWSERSLIST_IGNORE_OLD_DATA=true next dev --turbopack -H 0.0.0.0 -p 4000",
    "build": "node -e \"const { spawnSync } = require('node:child_process'); const env = { ...process.env, BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA: 'true', BROWSERSLIST_IGNORE_OLD_DATA: 'true' }; const command = process.platform === 'win32' ? 'pnpm.cmd' : 'pnpm'; const result = spawnSync(command, ['exec', 'next', 'build'], { stdio: 'inherit', env, shell: false }); process.exit(result.status ?? 1);\"",
    "start": "BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true BROWSERSLIST_IGNORE_OLD_DATA=true PORT=4000 next start -H 0.0.0.0",
    "menu": "pnpm exec tsx scripts/cli-menu.ts",
    "ios:build-and-install": "bash ./mobile/build-and-install.sh",
    "db:setup": "npx tsx lib/db/setup.ts",
    "db:seed": "npx tsx lib/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:clean-disseminator-preview-values": "npx tsx scripts/clean-disseminator-preview-values.ts",
    "backup:env": "bash scripts/backup-env.sh",
    "stripe:prepare-verification": "pnpm exec tsx scripts/prepare-stripe-verification-price.ts",
    "stripe:verify-callback": "pnpm exec tsx scripts/verify-stripe-signup-callback.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1021.0",
    "@aws-sdk/s3-request-presigner": "^3.1021.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-cloud/vision": "^5.3.5",
    "@hello-pangea/dnd": "^18.0.1",
    "@neondatabase/serverless": "^1.0.0",
    "@radix-ui/react-avatar": "^1.1.9",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.3.6",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@railway/cli": "^4.5.3",
    "@tailwindcss/postcss": "4.1.7",
    "@tanstack/react-table": "^8.21.3",
    "@types/html2canvas": "^1.0.0",
    "@types/node": "^22.15.18",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@types/tesseract.js": "^2.0.0",
    "autoprefixer": "^10.5.0",
    "bcryptjs": "^3.0.2",
    "canvas": "^3.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.43.1",
    "html2canvas": "^1.4.1",
    "jose": "^6.0.11",
    "jspdf": "^3.0.1",
    "konva": "^10.2.0",
    "lucide-react": "^0.511.0",
    "next": "15.6.0-canary.61",
    "next-auth": "^4.24.11",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^5.5.207",
    "postcss": "^8.5.3",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-colorful": "^5.6.1",
    "react-day-picker": "^9.7.0",
    "react-dom": "19.1.0",
    "react-konva": "^19.2.3",
    "server-only": "^0.0.1",
    "sonner": "^2.0.5",
    "stripe": "^18.1.0",
    "swr": "^2.3.3",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "4.1.7",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.8.3",
    "vercel": "^54.3.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "baseline-browser-mapping": "^2.10.27",
    "tsx": "^4.21.0"
  }
}
