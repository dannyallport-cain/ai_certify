# Example Railway worker environment for Oracle Cloud Always Free + Ollama
# running on a separate Ampere A1 Ubuntu VM.
#
# Use this as a checked-in reference file only.
# In Railway, set these as service environment variables instead of committing
# real endpoints, secrets, or internal IP addresses.
#
# The worker supports shared LOCAL_LLM_* variables plus provider-specific
# OLLAMA_* variables. When LOCAL_LLM_PROVIDER=ollama, the worker prefers
# LOCAL_LLM_BASE_URL and LOCAL_LLM_MODEL, then falls back to OLLAMA_*.

# Explicitly enable the Ollama provider.
LOCAL_LLM_PROVIDER=ollama

# Base URL for your Oracle-hosted Ollama server.
# Use a reachable URL from Railway, ideally HTTPS behind a reverse proxy.
# Example public endpoint:
# LOCAL_LLM_BASE_URL=https://ollama.example.com
# Example direct VM endpoint:
# LOCAL_LLM_BASE_URL=http://123.45.67.89:11434
LOCAL_LLM_BASE_URL=https://ollama.example.com

# Small CPU-friendly model recommended for Always Free ARM instances.
# Good starting points:
# - llama3.2:3b
# - qwen2.5:3b
# - gemma2:2b
LOCAL_LLM_MODEL=llama3.2:3b

# Optional Ollama-specific mirrors.
# These are useful if you also want provider-specific variables populated,
# or if you remove LOCAL_LLM_BASE_URL / LOCAL_LLM_MODEL later.
OLLAMA_BASE_URL=https://ollama.example.com
OLLAMA_MODEL=llama3.2:3b

# Optional: force-disable provider integration if you want OCR/rules only.
# LOCAL_LLM_PROVIDER=disabled

# Operational note:
# The Railway worker does not run Ollama itself. Ollama should run on the
# Oracle VM and expose its API to Railway over a reachable network path.

# Security note:
# Do not leave Ollama openly exposed to the public internet without controls.
# Prefer HTTPS plus authentication, IP allow-listing, VPN/Tailscale, or a
# reverse proxy with access restrictions.

# Verification after deploy:
# GET /health?probeProvider=true
# Expect localLlm.provider=ollama and, if reachable, status=ok.