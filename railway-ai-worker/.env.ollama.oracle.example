# Example Railway worker environment for an OpenRouter-backed hosted model.
#
# Use this as a checked-in reference file only.
# In Railway, set these as service environment variables instead of committing
# real endpoints, secrets, or internal IP addresses.
#
# This worker treats OpenRouter as an OpenAI-compatible provider. Configure
# the shared LOCAL_LLM_* variables and provide the API key via
# OPENROUTER_API_KEY. The code also accepts OPENAI_API_KEY, but for
# OpenRouter the clearer variable name is OPENROUTER_API_KEY.

# Explicitly enable the OpenAI-compatible provider mode.
# Accepted values include: lmstudio, openai, openai-compatible
LOCAL_LLM_PROVIDER=openai

# Base URL for OpenRouter's OpenAI-compatible API.
LOCAL_LLM_BASE_URL=https://openrouter.ai/api/v1

# Model identifier to use for hosted inference.
# Example models:
# - openai/gpt-4o-mini
# - google/gemma-3-4b-it
# - anthropic/claude-3.5-haiku
LOCAL_LLM_MODEL=google/gemma-3-4b-it

# Required secret. Set this in Railway service variables, not in git.
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: force-disable provider integration if you want OCR/rules only.
# LOCAL_LLM_PROVIDER=disabled

# Operational note:
# The Railway worker does not host the model runtime itself when using
# OpenRouter. It calls OpenRouter over HTTPS using the configured API key.

# Security note:
# Never commit a real API key. Keep it only in Railway environment variables
# or another secret manager.

# Verification after deploy:
# GET /health?probeProvider=true
# Expect localLlm.provider=lmstudio (openai-compatible mode) and, if
# reachable with a valid key, status=ok.
