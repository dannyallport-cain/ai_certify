  "rules": [
    {
      "id": "gn3-missing-circuit-identification-review",
      "issueType": "labeling",
      "severity": "medium",
      "message": "OCR wording suggests circuit identification may be absent or unclear; review inspection findings against Guidance Note 3 expectations for clear identification.",
      "source": "gn3.curated",
      "confidence": 0.9,
      "needsHumanReview": true,
      "suggestedCodes": [
        "manual-review"
      ],
      "authority": [
        {
          "standard": "Guidance Note 3",
          "title": "Inspection and Testing"
        }
      ],
      "metadata": {
        "domain": "inspection_testing",
        "focus": "circuit_identification",
        "curation": "high_precision_text_review"
      },
      "conditions": {
        "any": [
          {
            "path": "text.joinedLower",
            "op": "contains",
            "value": "circuit identification missing"
          },
          {
            "path": "text.joinedLower",
            "op": "contains",
            "value": "circuit identification unclear"
          },
          {
            "path": "text.joinedLower",
            "op": "contains",
            "value": "circuits not identified"
          },
          {
            "path": "text.joinedLower",
            "op": "contains",
            "value": "unidentified circuit"
          },
          {
            "path": "text.joinedLower",
            "op": "contains",
            "value": "way identification missing"
          }
        ]
      },
      "evidence": [
        {
          "label": "matchedText",
          "path": "text.lines"
        }
      ]
    },
