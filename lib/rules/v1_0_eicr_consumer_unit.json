    {
      "id": "device-type-ac-detected",
      "issueType": "protective_device",
      "severity": "medium",
      "message": "Type AC wording was detected and should be reviewed for suitability.",
      "source": "ocr_text",
      "confidence": 0.9,
      "needsHumanReview": true,
      "suggestedCodes": [
        "manual-review"
      ],
      "conditions": {
        "any": [
          {
            "path": "text.joinedLower",
            "op": "contains",
            "value": "type ac"
          },
          {
            "path": "text.joinedLower",
            "op": "contains",
            "value": "ac rcd"
          }
        ]
      },
      "evidence": [
        {
          "label": "matchedText",
          "path": "text.lines"
        }
      ]
    },
