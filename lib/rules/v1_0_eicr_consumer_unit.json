{
  "version": "1.0",
  "name": "eicr-consumer-unit-v1.0",
  "description": "Deterministic OCR and certificate consistency checks for consumer unit / EICR workflows.",
  "rules": [
    {
      "id": "img-quality-no-text",
      "issueType": "image_quality",
      "severity": "high",
      "message": "No OCR text was extracted from the image, so component inference is unreliable.",
      "source": "ocr",
      "confidence": 0.99,
      "needsHumanReview": true,
      "suggestedCodes": [
        "manual-review",
        "retake-image"
      ],
      "conditions": {
        "all": [
          {
            "path": "ocr.lineCount",
            "op": "eq",
            "value": 0
          }
        ]
      },
      "evidence": [
        {
          "label": "ocr.lineCount",
          "path": "ocr.lineCount"
        },
        {
          "label": "imageQuality.status",
          "path": "imageQuality.status"
        }
      ]
    },
    {
      "id": "img-quality-poor",
      "issueType": "image_quality",
      "severity": "medium",
      "message": "OCR image quality appears poor and may limit reliable identification.",
      "source": "ocr",
      "confidence": 0.92,
      "needsHumanReview": true,
      "suggestedCodes": [
        "manual-review",
        "retake-image"
      ],
      "conditions": {
        "any": [
          {
            "path": "imageQuality.status",
            "op": "in",
            "value": [
              "poor",
              "low",
              "unavailable"
            ]
          },
          {
            "path": "imageQuality.isBlurry",
            "op": "eq",
            "value": true
          },
          {
            "path": "imageQuality.isLowContrast",
            "op": "eq",
            "value": true
          },
          {
            "path": "imageQuality.isDark",
            "op": "eq",
            "value": true
          }
        ]
      },
      "evidence": [
        {
          "label": "imageQuality.status",
          "path": "imageQuality.status"
        },
        {
          "label": "imageQuality.isBlurry",
          "path": "imageQuality.isBlurry"
        },
        {
          "label": "imageQuality.isLowContrast",
          "path": "imageQuality.isLowContrast"
        },
        {
          "label": "imageQuality.isDark",
          "path": "imageQuality.isDark"
        }
      ]
    },
